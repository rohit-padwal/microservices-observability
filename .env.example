# Copy this file to .env and fill in real values before running
# `docker compose up`. Never commit the real .env file.

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Alertmanager: Slack ---
# Create an "Incoming Webhook" in your Slack workspace and paste the URL here.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME/NOW

# --- Alertmanager: Email ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=alerts@example.com
SMTP_USER=alerts@example.com
SMTP_PASSWORD=replace-me
ALERT_EMAIL_TO=oncall@example.com

# --- Chaos testing ---
# Set to "chaos" to enable payment-service's /internal/chaos/* endpoints
# (used by chaos/memory-leak.sh). Leave as "default" otherwise — these
# endpoints intentionally leak memory and should never run in production.
PAYMENT_SERVICE_PROFILE=default
